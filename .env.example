# ============================================
# SCATERX – PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# 🔴 IMPORTANT: 
#   - Replace ALL placeholders with strong secrets.
#   - NEVER use 'NEXT_PUBLIC_' for any sensitive value.
#   - Run: openssl rand -base64 32  to generate secrets.
# ============================================

NODE_ENV=production
PORT=4000

# ========== AUTHENTICATION ==========
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_32_BYTE_BASE64
JWT_ROTATION_SECRET=REPLACE_WITH_DIFFERENT_32_BYTE_BASE64

# ❌ REMOVED: NEXT_PUBLIC_ADMIN_DASHBOARD_TOKEN
# Reason: Exposes admin access to the browser.
# Use server‑side sessions + JWT instead.

# ========== DATABASE ==========
# Strong password (min 20 chars, alphanumeric + symbols)
DATABASE_URL=postgresql://scaterx:REPLACE_STRONG_DB_PASSWORD@your-db-host:5432/scaterx
DB_USER=scaterx
DB_PASSWORD=REPLACE_STRONG_DB_PASSWORD   # Same as above
DB_NAME=scaterx

# ========== REDIS ==========
# Use a password in production: redis://:yourpassword@host:6379
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@your-redis-host:6379

# ========== ADMIN API ==========
# Replace with strong random token, but better: switch to JWT.
# Keep this token secret (never expose to frontend).
ADMIN_API_TOKEN=REPLACE_WITH_STRONG_RANDOM_TOKEN

# ========== PAYMENT / WEBHOOKS ==========
# HMAC signing secret – min 32 chars
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_32_PLUS_CHARS

# Third‑party keys – use actual keys from dashboards
XENDIT_API_KEY=replace_with_xendit_live_key
PAYMONGO_SECRET_KEY=replace_with_paymongo_live_secret
DRAGONPAY_SECRET=replace_with_dragonpay_merchant_secret
WALLETCONNECT_PROJECT_ID=replace_with_walletconnect_project_id

# ========== FIREBASE (optional) ==========
# Not a secret, but change to your actual project ID
FIREBASE_PROJECT_ID=your-actual-firebase-project-id

# ========== API BASE (frontend) ==========
# This is public, but must use HTTPS in production.
NEXT_PUBLIC_API_BASE_URL=https://your-api-domain.com

# ========== ADDITIONAL SECURITY ==========
# Rate limiting & nonce protection (recommended)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
NONCE_EXPIRY_SECONDS=300